# Copy to .env and fill in. Never commit .env.
# Generate each secret with: openssl rand -base64 32

HOST=0.0.0.0
PORT=1337

# Comma-separated, at least two keys
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

# Consumed by both Strapi and docker-compose.yml
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=vinyl_backoffice
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=
DATABASE_SSL=false

# mock = no network call (default, required for the documented test run)
# api  = real Discogs API, needs DISCOGS_API_TOKEN
DISCOGS_MODE=mock
DISCOGS_API_TOKEN=
DISCOGS_API_BASE_URL=https://api.discogs.com
DISCOGS_USER_AGENT=VinylBackoffice/0.1
